{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "github-copilot": {
      "models": {
        // this fixes `Error: thinking.adaptive.block_binding: Extra inputs are not permitted`
        // Codespaces authenticate OpenCode's Copilot provider with GITHUB_TOKEN (instead of gh-cli oauth)
        // a path that drops the anthropic-beta needed by thinking.block_binding
        // possibly an opencode bug, and thus possible cruft once we take an opencode update past v2.2.1 (the version where i noticed this behavior)
        "claude-fable-5.1": { "compatibility": { "supportsThinkingBlockBinding": false } },
        "claude-opus-5.5": { "compatibility": { "supportsThinkingBlockBinding": false } },
        "claude-sonnet-5.5": { "compatibility": { "supportsThinkingBlockBinding": false } }
      }
    }
  },
  "mcp": {
    "servers": {
      "workiq": {
        "type": "remote",
        "url": "https://workiq.svc.cloud.microsoft/mcp",
        "oauth": {
          "client_id": "ba081686-5d24-4bc6-a0d6-d034ecffed87",
          "callback_port": 12798,
          "redirect_uri": "http://localhost:12798/",
          "scope": "fdcc1f02-fc51-4226-8753-f668596af7f7/WorkIQAgent.Ask",
          "auth_server_metadata_url": "https://login.microsoftonline.com/milliman.com/v2.0/.well-known/openid-configuration"
        }
      }
    }
  }
}
